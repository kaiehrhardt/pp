{
  "name": "pp",
  "module": "src/backend/index.ts",
  "type": "module",
  "private": true,
  "version": "3.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "bun --hot src/backend/index.ts",
    "start": "bun src/backend/index.ts",
    "test": "bun test src",
    "test:coverage": "bun test --coverage src",
    "test:e2e": "docker compose -f docker-compose.e2e.yml up -d --wait && bun --config=bunfig.e2e.toml test e2e; ec=$?; docker compose -f docker-compose.e2e.yml down; exit $ec",
    "release": "semantic-release",
    "docker:build": "docker build -t planning-poker .",
    "docker:run": "docker run --rm -p 3000:3000 planning-poker",
    "compose": "docker compose up --build",
    "compose:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "compose:prod": "docker compose -f docker-compose.prod.yml up"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "playwright": "1.62.1",
    "semantic-release": "25.0.8",
    "semantic-release-helm3": "2.10.0"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "i18next": "26.3.6",
    "nanoid": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11"
  }
}
